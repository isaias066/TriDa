{
  "name": "trida-frontend",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm type-check && vite build",
    "build:local": "pnpm type-check && vite build --mode development",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../.gitignore",
    "format:check": "prettier --check . --ignore-path ../.gitignore",
    "test": "vitest run --environment jsdom --mode development",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "1.7.9",
    "clsx": "2.1.1",
    "lucide-react": "0.453.0",
    "maplibre-gl": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.28.0",
    "tailwind-merge": "2.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.33",
    "prettier": "3.4.2",
    "tailwindcss": "~3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  }
}
